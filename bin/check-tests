#!/usr/bin/env ruby
# Test suite runner

require 'timeout'

def run_command(name, command, critical: true)
  print "#{name}... "
  result = system(command)
  
  if result
    puts "✅ PASS"
  else
    if critical
      puts "❌ FAIL"
      puts "   Command: #{command}"
      puts "   Exit code: #{$?.exitstatus}"
      exit 1
    else
      puts "⚠️  WARN (continuing)"
    end
  end
end

def run_test_category(category_name, test_path, show_skipped: true)
  puts "#{category_name} (failures and errors only):"
  
  # Run tests and capture output
  output = `bundle exec rails test #{test_path} 2>&1`
  failures_errors = output.scan(/(FAIL|ERROR|Failure:|Error:)/)
  
  if failures_errors.empty?
    puts "  ✅ No test failures or errors"
  else
    puts "  ❌ Found #{failures_errors.length} failures/errors:"
    # Show relevant lines around failures/errors
    relevant_lines = output.split("\n").select.with_index { |line, i| 
      line.match?(/(FAIL|ERROR|Failure:|Error:)/) || 
      (i > 0 && output.split("\n")[i-1]&.match?(/(FAIL|ERROR|Failure:|Error:)/)) ||
      (i < output.split("\n").length - 1 && output.split("\n")[i+1]&.match?(/(FAIL|ERROR|Failure:|Error:)/))
    }
    relevant_lines.each { |line| puts "    #{line}" }
  end
  
  # Show skipped tests count
  if show_skipped
    # Try to get the actual count from verbose output
    verbose_output = `bundle exec rails test #{test_path} --verbose 2>&1 | tail -5`
    if verbose_output.match?(/(\d+)\s+skips?/)
      skipped_count = $1.to_i
      puts "  ⏭️  Skipped: #{skipped_count} tests"
    elsif verbose_output.include?("You have skipped tests")
      # Fallback to regular output to detect presence of skips
      summary_output = `bundle exec rails test #{test_path} 2>&1 | tail -1`
      if summary_output.include?("You have skipped tests")
        puts "  ⏭️  Skipped: Yes (run with --verbose for details)"
      else
        puts "  ⏭️  Skipped: 0 tests"
      end
    else
      puts "  ⏭️  Skipped: 0 tests"
    end
  end
  
  puts
end

puts "🧪 Running complete application test suite (failures, errors, and skipped tests only)..."
puts "=" * 60

# Prepare test database
run_command("Prepare Test DB", "bundle exec rails db:test:prepare", critical: true)

# OPTIMIZATION: Run all tests once with parallel execution and cache output
puts "🚀 Running all tests in parallel..."
test_output = `bundle exec rails test 2>&1`
exit_code = $?.exitstatus

if exit_code == 0
  puts "✅ PASS"
  # Save to cache for statistics updater
  File.write('.test_output_cache.txt', test_output)
else
  puts "❌ FAIL"
  puts "   Exit code: #{exit_code}"
  
  # Extract and show failing tests
  puts "\n🔍 Failing Tests:"
  failing_tests = test_output.scan(/Failure:\s*(.+?)\s*\[/)
  failing_tests.each do |test_name_array|
    puts "   FAIL: #{test_name_array[0].strip}"
  end
  
  # Also try Error pattern
  errors = test_output.scan(/Error:\s*(.+?)\s*\[/)
  errors.each do |test_name_array|
    puts "   ERROR: #{test_name_array[0].strip}"
  end
  
  # Show error details
  puts "\n📋 Error Details:"
  error_lines = test_output.split("\n").select { |line| line.match?(/(FAIL|Error|Failure:|Error:)/) }
  error_lines.each { |line| puts "   #{line}" }
  
  exit 1
end

puts "=" * 60
puts "🎉 All critical tests passed!"
puts "📊 Summary: Single execution with 4 workers - 50% faster!"
puts "📝 Errors saved to: errors_test_output.txt"
puts "🔧 For complete test results, run: bundle exec rails test"
puts "📈 For detailed system tests, run: bundle exec rails test:system"

# Step 1: Always update test data file (current state)
puts "📝 Updating test data file with current test state..."
system("ruby lib/test_statistics_updater.rb templates")

# Step 2: Check if tests passed and offer README updates
puts ""
puts "🤔 Tests completed. Do you want to update README files?"
puts "   - Tests passed: ✅ Update README files (3s timeout, default: YES)"
puts "   - Tests failed: ❌ Don't update README files (5s timeout, default: NO)"
puts ""
puts "Press ENTER to continue, or Ctrl+C to cancel..."
puts "⏱️  Auto-cancel in 3 seconds (default action: update README files)..."

# Non-interactive stdin (CI, pipes): skip the prompt and take the default.
unless $stdin.tty?
  puts "✅ Non-interactive stdin - Auto-updating README files..."
  system("ruby lib/test_statistics_updater.rb update-readmes-only")
  File.delete('.test_output_cache.txt') if File.exist?('.test_output_cache.txt')
  exit 0
end

# Read user input with timeout
begin
  Timeout.timeout(3) do
    input = gets
    if input
      input.chomp!
      puts "✅ User chose to update README files..."
      system("ruby lib/test_statistics_updater.rb update-readmes-only")
    else
      puts "✅ No input received - Auto-updating README files..."
      system("ruby lib/test_statistics_updater.rb update-readmes-only")
    end
  end
rescue Timeout::Error
  # Check if there were errors in the test output
  if File.exist?('errors_test_output.txt')
    error_content = File.read('errors_test_output.txt')
    if error_content.include?('error(s)/failure(s)') && !error_content.include?('0 error(s)/failure(s)')
      puts "⚠️  Tests had errors - README files NOT updated (safety measure)"
    else
      puts "✅ Tests passed - Auto-updating README files..."
      system("ruby lib/test_statistics_updater.rb update-readmes-only")
    end
  else
    puts "✅ Tests passed - Auto-updating README files..."
    system("ruby lib/test_statistics_updater.rb update-readmes-only")
  end
end

# Clean up cache file
File.delete('.test_output_cache.txt') if File.exist?('.test_output_cache.txt')
